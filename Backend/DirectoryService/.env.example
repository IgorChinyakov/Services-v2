ASPNETCORE_ENVIRONMENT=Development
DIRECTORY_SERVICE_IMAGE=directory-service:local
FRONTEND_IMAGE=directory-service-frontend:local
NGINX_IMAGE=nginx:1.27-alpine
NGINX_HTTP_PORT=80
NEXT_PUBLIC_API_URL=/api/

POSTGRES_IMAGE=postgres:16
POSTGRES_DB=directory_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

SEQ_IMAGE=datalust/seq:latest
SEQ_FIRSTRUN_NOAUTHENTICATION=true

REDIS_IMAGE=redis:7.4-alpine
REDIS_ENABLED=true
REDIS_CONNECT_TIMEOUT_MILLISECONDS=1000
REDIS_OPERATION_TIMEOUT_MILLISECONDS=1000

DEPARTMENT_CLEANUP_ENABLED=true
DEPARTMENT_CLEANUP_CRON_SCHEDULE=0 0 2 * * ?
DEPARTMENT_CLEANUP_RETENTION_DAYS=30
DEPARTMENT_CLEANUP_BATCH_SIZE=100
