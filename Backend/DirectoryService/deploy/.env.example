# Follow the common multi-platform latest tag. Updates still require pull + up.
# To deploy a specific version, use sha-<full-commit> instead (no arch suffix).
IMAGE_TAG=latest

POSTGRES_DB=directory_service
POSTGRES_USER=directory_service
# Generate separate passwords with: openssl rand -hex 32
POSTGRES_PASSWORD=
SEQ_PASSWORD=

# Only nginx is published on the VM. Databases and Seq have no published ports.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080

# Optional infrastructure image overrides (tags or digests).
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7.4-alpine
SEQ_IMAGE=datalust/seq:latest
NGINX_IMAGE=nginx:1.30.7-alpine
